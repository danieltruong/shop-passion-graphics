# Used by generate-products.js at build time to fetch product catalog from Stripe.
# Server-side only — never exposed to the browser.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# VITE_CHECKOUT_API_URL — you do NOT need to set this manually.
# In production, it is automatically derived from the SAM CloudFormation stack output
# and injected into the Vite build by deploy.yml. No GitHub secret required.
# For local dev, CartDrawer automatically falls back to /.netlify/functions/create-checkout
# when this variable is not set (which is always the case locally).
# VITE_CHECKOUT_API_URL=https://your-api-gateway-url/create-checkout
