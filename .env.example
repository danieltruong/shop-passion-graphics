# ── Local development (.env.local) ───────────────────────────────────────────
# .env.local is gitignored and must stay that way.

# Used by scripts/generate-products.js to fetch the catalog from Stripe, by the local Netlify
# checkout function, and by the Stripe MCP server (scripts/mcp-stripe-headers.sh reads this file
# at connection time — the MCP config references the key rather than storing a copy).
# Server-side only — never exposed to the browser.
#
# In production the Lambda does NOT use this: it reads an SSM SecureString via
# STRIPE_SECRET_ARN, so the key is never a plaintext environment variable.
# Those two locations — this file and SSM — are the only places the key should ever live.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Comma-separated allowlist of origins permitted to call the checkout function. Required —
# there is no wildcard fallback. The first entry is also the base URL for Stripe's
# success/cancel redirects, which is why it must never be derived from a request header.
# For `netlify dev`, that is the Netlify port:
ALLOWED_ORIGIN=http://localhost:8888

# VITE_CHECKOUT_API_URL — you do NOT need to set this manually.
# In production it is derived from the SAM CloudFormation stack output and injected into the
# Vite build by deploy.yml. Locally, CartDrawer falls back to
# /.netlify/functions/create-checkout when it is unset.
# VITE_CHECKOUT_API_URL=https://your-api-gateway-url/create-checkout


# ── GitHub Actions secrets (not read from this file) ─────────────────────────
# AWS_ROLE_ARN                 — IAM role assumed via OIDC by deploy.yml
# STRIPE_SECRET_ARN            — SSM SecureString parameter holding the Stripe key
# ALLOWED_ORIGIN               — as above; an unset value now fails the deploy
# S3_BUCKET_NAME               — website bucket
# CLOUDFRONT_DISTRIBUTION_ID   — optional, for cache invalidation
# CLOUDFRONT_DOMAIN            — optional, for the deploy summary URL
